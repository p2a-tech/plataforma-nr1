# ============================================================================
#  Contexto de build do Docker — exclui o que não deve ir para a imagem.
# ============================================================================

# Dependências e artefatos de build (reinstalados/regerados no build).
node_modules
**/node_modules
.next
out
build
*.tsbuildinfo

# Controle de versão / IDE.
.git
.gitignore
.vscode
.idea

# Segredos e ambiente (NUNCA entram na imagem — vêm via env em runtime).
.env
.env.*
!.env.production.example

# Banco de dados local: init/seed ficam fora da imagem, MAS as migrations
# entram (o entrypoint roda scripts/migrate.mjs no start). db/* exclui os
# filhos diretos; !db/migrations re-inclui só a pasta de migrations.
db/*
!db/migrations

# Docs e infra que não fazem parte do runtime do app.
*.md
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.prod.yml
Caddyfile
# scripts/* exclui os scripts locais, mas migrate.mjs + seed-admin.mjs entram
# (rodam no entrypoint).
scripts/*
!scripts/migrate.mjs
!scripts/seed-admin.mjs

# Plataformas externas / SO.
.vercel
.DS_Store
*.pem
