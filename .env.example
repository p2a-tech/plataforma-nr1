# ============================================================================
#  PrevIA · variáveis de ambiente (template). Copie para .env.local e ajuste.
# ============================================================================

# Conexão Postgres.
#  - Local (docker-compose): postgres://previa:previa_dev_pwd@localhost:5432/previa
#  - Produção (VPS): postgres://USER:SENHA@HOST_INTERNO:5432/previa
DATABASE_URL=postgres://previa:previa_dev_pwd@localhost:5432/previa

# Força SSL: "disable" | "require". Em geral detectado automaticamente.
# PGSSL=

# ----------------------------------------------------------------------------
# Segredos HMAC das clínicas parceiras.
# O segredo cru NUNCA vai para o banco — só o fingerprint (sha256). Em produção,
# use um Secret Manager. Formato: JSON { "clinica_id": "segredo" }
# ----------------------------------------------------------------------------
CLINIC_SECRETS_JSON={"clin_translog_demo":"demo-secret-do-not-use-in-prod"}

# Segredo para assinar sessões de login da clínica (troque em produção).
AUTH_SECRET=dev-auth-secret-previa-trocar-em-producao

# ----------------------------------------------------------------------------
# Variáveis do docker-compose (opcionais; têm defaults no compose).
# ----------------------------------------------------------------------------
# POSTGRES_USER=previa
# POSTGRES_PASSWORD=previa_dev_pwd
# POSTGRES_DB=previa
# POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# IA de extração (opcional). Sem chave, usa o extrator heurístico local.
# ----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
