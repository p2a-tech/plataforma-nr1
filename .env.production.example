# ============================================================================
#  PrevIA · variáveis de PRODUÇÃO (template)
# ----------------------------------------------------------------------------
#  Copie para  .env.production  e preencha. NÃO faça commit do .env.production.
#  Lido por docker-compose.prod.yml (serviços `app`, `db`, `migrate`, `caddy`).
#
#  Gere segredos fortes com, por exemplo:
#    openssl rand -hex 32
# ============================================================================

# ---------------------------------------------------------------------------
# Postgres (serviço `db` do compose). O banco fica SÓ na rede interna.
# ---------------------------------------------------------------------------
POSTGRES_USER=previa
POSTGRES_PASSWORD=TROQUE_por_uma_senha_forte_aqui
POSTGRES_DB=previa

# Connection string usada pelo app e pelo migrate.
#  - Host `db` = nome do serviço Postgres na rede interna do compose.
#  - SSL é desligado automaticamente para o host `db` (lib/db.ts), pois o
#    Postgres do compose não expõe TLS — o tráfego nunca sai da rede interna.
#  - Mantenha usuário/senha/banco em sincronia com as 3 variáveis acima.
DATABASE_URL=postgres://previa:TROQUE_por_uma_senha_forte_aqui@db:5432/previa

# (Opcional) Força SSL: "disable" | "require". Em geral não é necessário.
# PGSSL=

# ---------------------------------------------------------------------------
# Domínio público (usado pelo Caddy para emitir o certificado TLS).
# Aponte o DNS A/AAAA deste domínio para o IP da VPS ANTES de subir o Caddy.
# ---------------------------------------------------------------------------
DOMAIN=previa.suaempresa.com.br

# ---------------------------------------------------------------------------
# Segredos da aplicação. TROQUE TODOS em produção.
# ---------------------------------------------------------------------------
# Assina as sessões de login da clínica.
AUTH_SECRET=TROQUE_openssl_rand_hex_32

# Assina (HMAC) o selo das assinaturas do PGR. Se ausente, cai no AUTH_SECRET.
PGR_SECRET=TROQUE_openssl_rand_hex_32

# Segredos HMAC das clínicas parceiras (validação de webhook).
#  - O segredo CRU nunca vai para o banco — só o fingerprint (sha256).
#  - Formato: JSON { "clinica_id": "segredo" }. Use aspas simples ao redor.
CLINIC_SECRETS_JSON={"clin_translog_demo":"TROQUE_pelo_segredo_real_da_clinica"}

# ---------------------------------------------------------------------------
# IA de extração (OPCIONAL). Sem chave, usa o extrator heurístico local.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (OPCIONAL — Radar / micro-pulsos via WhatsApp).
# Sem estas variáveis, o canal WhatsApp fica desabilitado.
# ---------------------------------------------------------------------------
# WHATSAPP_TOKEN=             # token de acesso da WhatsApp Cloud API
# WHATSAPP_PHONE_ID=          # ID do número de telefone (phone_number_id)
# WHATSAPP_VERIFY_TOKEN=      # token de verificação do webhook (você define)
# WHATSAPP_APP_SECRET=        # app secret (valida a assinatura X-Hub-Signature)
# WHATSAPP_SALT=              # salt p/ hash do telefone (anonimização)
