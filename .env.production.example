# ============================================================================
#  PrevIA · variáveis de PRODUÇÃO (template)
# ----------------------------------------------------------------------------
#  Copie para .env.production (ou configure no painel do Dokploy/PaaS).
#  NÃO faça commit do .env.production.
#
#  Gere segredos fortes com:
#    openssl rand -hex 32
# ============================================================================

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------------
# Banco de dados — TRÊS conexões por causa do RLS (multi-tenancy).
# ---------------------------------------------------------------------------
#  - DATABASE_URL        → role SUPERUSER. Usada pelo migrate (scripts/migrate.mjs)
#                          para aplicar as migrations e criar as roles previa_*.
#  - DATABASE_URL_ADMIN  → conexão com BYPASS de RLS (login, admin, webhooks,
#                          leitura cross-tenant). O superuser serve (bypassa RLS).
#  - DATABASE_URL_APP    → role `previa_app` (nosuperuser, NOBYPASSRLS). TODAS as
#                          queries de tenant passam por aqui — o Postgres aplica
#                          RLS e isola por empresa. NUNCA use o superuser aqui.
#
#  O banco deve se chamar `previa` (a migration 0006 faz
#  `grant connect on database previa`). SSL é desligado p/ hosts internos
#  (db, previa-db, localhost) automaticamente — ver lib/db.ts / migrate.mjs.
DATABASE_URL=postgres://previa:TROQUE_senha_super@db:5432/previa
DATABASE_URL_ADMIN=postgres://previa:TROQUE_senha_super@db:5432/previa
DATABASE_URL_APP=postgres://previa_app:TROQUE_senha_previa_app@db:5432/previa

# (Opcional) Força SSL: "disable" | "require".
# PGSSL=

# ---------------------------------------------------------------------------
# Segredos da aplicação. TROQUE TODOS. (openssl rand -hex 32)
# ---------------------------------------------------------------------------
# Assina as sessões de login (HMAC). Fail-closed em produção se ausente.
AUTH_SECRET=TROQUE_openssl_rand_hex_32

# Assina (HMAC) o selo das assinaturas do PGR. Se ausente, cai no AUTH_SECRET.
PGR_SECRET=TROQUE_openssl_rand_hex_32

# Key Encryption Key (AES-256-GCM) p/ cifrar segredos de clínica no banco.
# DEVE ter 32 bytes = 64 caracteres hex. Fail-closed em prod se ausente.
CLINIC_KEK=TROQUE_openssl_rand_hex_32

# Sal p/ hash (sha256) de IP em leads da landing e auditoria de acesso (LGPD).
LP_IP_SALT=TROQUE_openssl_rand_hex_32

# Segredos HMAC das clínicas parceiras (validação de webhook).
#  - O segredo CRU nunca vai para o banco — só o fingerprint (sha256) + cifrado.
#  - Formato: JSON { "clinica_id": "segredo" }.
CLINIC_SECRETS_JSON={"clin_translog_demo":"TROQUE_pelo_segredo_real_da_clinica"}

# ---------------------------------------------------------------------------
# Analytics da landing /nr1 (OPCIONAL). Sem isso, Pixel/GA ficam no-op.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# IA de extração (OPCIONAL). Sem chave, usa o extrator heurístico local.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (OPCIONAL — Radar / micro-pulsos via WhatsApp).
# ---------------------------------------------------------------------------
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_SALT=
